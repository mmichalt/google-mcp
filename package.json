{
  "name": "google-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Google Workspace MCP server",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "auth": "npm run build && node dist/scripts/setup-auth.js",
    "doctor": "npm run build && node dist/scripts/doctor.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "google-auth-library": "^11.2.0",
    "googleapis": "^184.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}

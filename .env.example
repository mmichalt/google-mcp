# Environment variables only; this file is a template, not loaded automatically.
GOOGLE_MCP_SERVICES=forms,drive
# Optional services: tasks,sheets,docs,meet,calendar,gmail (enable their APIs and rerun auth).
# GOOGLE_MCP_SERVICES=forms,drive,tasks,sheets,docs,meet,calendar,gmail
# Absolute path to Desktop OAuth client credentials downloaded from Google Cloud.
GOOGLE_MCP_CREDENTIALS=/absolute/path/to/credentials.json
# Optional: shared auth directory (default: ~/.google-mcp, or LOCALAPPDATA/google-mcp on Windows).
# GOOGLE_MCP_AUTH_DIR=/absolute/path/to/private/google-mcp
# Explicit opt-in to drive.readonly and drive_read_text, including non-attachment content.
GOOGLE_MCP_DRIVE_ATTACHMENTS=false
# Expose gmail_send_message; requires gmail. The draft OAuth scope already permits sending.
GOOGLE_MCP_GMAIL_SEND=false
# Optional fixed loopback port for WSL troubleshooting; default random free port.
# GOOGLE_MCP_AUTH_PORT=3000
# Optional known resources for doctor and read-only live tests.
# GOOGLE_MCP_TEST_FORM_ID=YOUR_FORM_ID
# GOOGLE_MCP_TEST_SPREADSHEET_ID=YOUR_SPREADSHEET_ID
# GOOGLE_MCP_TEST_DOCUMENT_ID=YOUR_DOCUMENT_ID
# GOOGLE_MCP_TEST_TASKLIST_ID=@default
# GOOGLE_MCP_TEST_CONFERENCE_NAME=conferenceRecords/CONFERENCE_ID
# GOOGLE_MCP_TEST_TRANSCRIPT_NAME=conferenceRecords/CONFERENCE_ID/transcripts/TRANSCRIPT_ID
# GOOGLE_MCP_INTEGRATION=true

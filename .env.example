# Environment variables only; this file is a template, not loaded automatically.
GOOGLE_MCP_SERVICES=forms,drive
# Absolute path to Desktop OAuth client credentials downloaded from Google Cloud.
GOOGLE_MCP_CREDENTIALS=/absolute/path/to/credentials.json
# Optional: shared auth directory (default: ~/.google-mcp, or LOCALAPPDATA/google-mcp on Windows).
# GOOGLE_MCP_AUTH_DIR=/absolute/path/to/private/google-mcp
# Explicit opt-in to drive.readonly for attachment content access; no download tool in v1.
GOOGLE_MCP_DRIVE_ATTACHMENTS=false
# Optional fixed loopback port for WSL troubleshooting; default random free port.
# GOOGLE_MCP_AUTH_PORT=3000
